# Public Supabase project URL used by browser-side Supabase integrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service-role/secret configuration.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Public site URL used in metadata and order-tracking emails.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Admin login configuration. Use a long random password in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Razorpay server credentials. Use live keys for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional transactional email via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Verdant <orders@your-domain.example>

# Optional WhatsApp Cloud API notifications.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
